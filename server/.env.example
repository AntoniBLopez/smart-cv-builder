PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:4200,https://smart-cv-builder-nine.vercel.app
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/cv-builder?retryWrites=true&w=majority
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# On Vercel, set the same secrets as Environment Variables.
# For Google Sign-In, authorize https://smart-cv-builder-nine.vercel.app in Google Cloud Console.

# AI — failover order: Groq → Gemini → Mistral → Cerebras → Cohere
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
MISTRAL_API_KEY_1=
CEREBRAS_API_KEY_1=
COHERE_API_KEY_1=
